# Variables d'environnement du service aether (systemd), prioritaires sur
# /var/lib/aether/aether.toml. Voir aether.example.toml et docs/INSTALL.md.
#AETHER_PORT=8096
#AETHER_HOST=0.0.0.0
#AETHER_TMDB_API_KEY=
#AETHER_LOG_LEVEL=info
# Accélération matérielle : none | auto | vaapi | qsv | nvenc
#AETHER_HWACCEL=vaapi
# FFmpeg de Jellyfin (paquet jellyfin-ffmpeg7), recommandé :
#AETHER_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg
#AETHER_FFPROBE=/usr/lib/jellyfin-ffmpeg/ffprobe
