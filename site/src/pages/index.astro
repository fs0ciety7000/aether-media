        TMDB sans être approuvé ni certifié par TMDB.
      </small>
    </div>
  </footer>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // Apparitions au défilement
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Écran signature : se redresse et s'éclaire au défilement
  const stage = document.querySelector<HTMLElement>('[data-screen]');
  if (stage) {
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let target = 0;
    let smooth = 0;
    let ticking = false;
    let init = false;
    const frame = () => {
      ticking = false;
      const r = stage.getBoundingClientRect();
      const vh = innerHeight;
      // 0 quand le haut de l'écran est en bas du viewport, 1 quand il atteint 28 % du haut
      target = clamp((vh - r.top) / (vh * 0.72));
      smooth = !init || reduce.matches ? target : smooth + (target - smooth) * 0.14;
      init = true;
      if (Math.abs(target - smooth) < 0.001) smooth = target;
      const p = 1 - Math.pow(1 - smooth, 2);
      stage.style.setProperty('--tilt', `${(22 * (1 - p)).toFixed(2)}deg`);
      stage.style.setProperty('--s', (0.9 + 0.1 * p).toFixed(4));
      stage.style.setProperty('--lum', (0.55 + 0.45 * p).toFixed(3));
      stage.style.setProperty('--lift', `${(-24 * p).toFixed(1)}px`);
      if (smooth !== target) request();
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    request();
  }

  // Onglets accessibles (lecture et installation)
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        for (const id of (t.getAttribute('aria-controls') ?? '').split(' ')) {
          const panel = document.getElementById(id);
          if (panel) panel.hidden = !on;
        }
      }
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let n = -1;
        if (k === 'ArrowRight') n = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') n = 0;
        else if (k === 'End') n = tabs.length - 1;
        if (n >= 0) {
          e.preventDefault();
          select(tabs[n], true);
        }
      });
    });
  });

  // Copier les commandes
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
    const status = btn.parentElement?.querySelector('[role="status"]');
    btn.addEventListener('click', async () => {
      const text = btn.parentElement?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('done');
        if (status) status.textContent = 'Commandes copiées';
        setTimeout(() => {
          btn.classList.remove('done');
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        /* presse-papiers indisponible : la sélection manuelle reste possible */
      }
    });
  });

  // Code d'appairage : les caractères se composent un à un
  const card = document.querySelector<HTMLElement>('[data-code]');
  if (card && !reduce.matches) {
    const cells = [...card.querySelectorAll<HTMLElement>('[data-c]')];
    const status = card.querySelector<HTMLElement>('[data-status]');
    const pool = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    cells.forEach((c) => (c.textContent = '·'));
    if (status) status.style.opacity = '0';
    const run = () => {
      cells.forEach((cell, i) => {
        let n = 0;
        const start = i * 120;
        const tick = () => {
          n++;
          if (n < 7) {
            cell.textContent = pool[Math.floor(Math.random() * pool.length)];
            setTimeout(tick, 45);
          } else {
            cell.textContent = cell.dataset.c!;
            cell.classList.add('on');
          }
        };
        setTimeout(tick, start);
      });
      if (status) {
        setTimeout(() => {
          status.style.transition = 'opacity .5s ease';
          status.style.opacity = '1';
        }, cells.length * 120 + 500);
      }
    };
    const co = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          co.disconnect();
          run();
        }
      },
      { threshold: 0.6 },
    );
    co.observe(card);
  } else if (card) {
    card.querySelectorAll('[data-c]').forEach((c) => c.classList.add('on'));
  }
</script>
